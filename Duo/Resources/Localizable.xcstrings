        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Continue to finish."
          }
        }
      }
    },
    "고급" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advanced"
          }
        }
      }
    },
    "글자" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syllable"
          }
        }
      }
    },
    "기본값 복원" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore Defaults"
          }
        }
      }
    },
    "기본값 복원…" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore Defaults…"
          }
        }
      }
    },
    "꺼짐" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off"
          }
        }
      }
    },
    "나중에" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Later"
          }
        }
      }
    },
    "다 해냈어요" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All done"
          }
        }
      }
    },
    "다른 앱이 보안 키보드 입력을 켜 두면 그동안 macOS가 Duo를 끄고, 입력 메뉴에서도 Duo를 고를 수 없어요. 그 앱에서 암호 칸을 벗어나거나, 보안 키보드 입력을 끄거나, 앱을 닫으면 다시 쓸 수 있어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While another app has Secure Keyboard Entry on, macOS turns Duo off and you can’t pick Duo in the input menu. Leave the password field in that app, turn Secure Keyboard Entry off, or quit the app to use Duo again."
          }
        }
      }
    },
    "다른 입력 소스" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another input source"
          }
        }
      }
    },
    "다시 시작" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume"
