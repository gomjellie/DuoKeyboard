    "한국어로 바꿈" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switched to Korean"
          }
        }
      }
    },
    "한영 전환 없이, 그냥 쓰세요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just type. No more switching."
          }
        }
      }
    },
    "해로 나오면 다 치기 전에 바꾸기 키를 눌러요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If it comes out as 해, press the flip key before the word ends."
