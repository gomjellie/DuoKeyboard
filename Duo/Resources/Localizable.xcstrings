          }
        }
      }
    },
    "한국어 뒤" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After Korean"
          }
        }
      }
    },
    "한국어 문장 속 go를 쓰는 중에 go ↔ 해 바꾸기" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
